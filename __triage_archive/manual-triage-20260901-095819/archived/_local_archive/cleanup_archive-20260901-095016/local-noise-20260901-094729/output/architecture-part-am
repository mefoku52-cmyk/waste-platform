
                if (value ~ /^\$\{.*\}$/) {
                    classification = "PLACEHOLDER/TEMPLATE"
                }

                if (value == "CHANGE_ME" ||
                    value == "CHANGEME" ||
                    value == "REPLACE_ME" ||
                    value == "YOUR_VALUE" ||
                    value == "YOUR_SECRET" ||
                    value == "placeholder" ||
                    value == "PLACEHOLDER" ||
                    value == "TODO" ||
                    value == "FIXME" ||
                    value == "xxx" ||
                    value == "XXX") {
                    classification = "PLACEHOLDER"
                }

                if (value == "true" ||
                    value == "false" ||
                    value == "null" ||
                    value == "none" ||
                    value == "localhost" ||
                    value == "127.0.0.1" ||
                    value ~ /^[0-9]+$/ ||
                    value ~ /^https?:\/\/localhost/) {
                    classification = "NON-SECRET-LIKE"
                }

                print key " => " classification
            }
            ' "$f"

            ;;
    esac

done

