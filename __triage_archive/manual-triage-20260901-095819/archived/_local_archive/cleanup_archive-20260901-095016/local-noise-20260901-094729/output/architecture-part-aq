      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
    restart: unless-stopped
    networks:
      - cmep-network

  api:
    build:
      context: .
      dockerfile: app/Dockerfile
    container_name: cmep-api
    environment:
      DATABASE_URL: postgresql+asyncpg://${POSTGRES_USER:-cmep}:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD musi byt nastaveny}@postgres:5432/${POSTGRES_DB:-cmep}
      REDIS_HOST: redis
      JWT_SECRET_KEY: ${JWT_SECRET_KEY:?JWT_SECRET_KEY musi byt nastaveny}
      JWT_REFRESH_SECRET_KEY: ${JWT_REFRESH_SECRET_KEY:?JWT_REFRESH_SECRET_KEY musi byt nastaveny}
      CORS_ALLOWED_ORIGINS: ${CORS_ALLOWED_ORIGINS:-http://localhost:3001}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped
    networks:
      - cmep-network

  web:
    build:
      context: ./apps/web
      dockerfile: Dockerfile
    container_name: cmep-web
    environment:
      NEXT_PUBLIC_API_BASE_URL: ${NEXT_PUBLIC_API_BASE_URL:-http://localhost:8000}
    depends_on:
      api:
        condition: service_started
    restart: unless-stopped
    networks:
      - cmep-network

networks:
  cmep-network:
    driver: bridge

volumes:
  postgres_data:
  redis_data:

--- docker/backend/Dockerfile ---
FROM python:3.11-slim

WORKDIR /app

# Inštalácia systémových závislostí
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Kopírovanie requirements
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Kopírovanie kódu
COPY backend/ .

# Vytvorenie užívateľa
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Spustenie
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

--- docker/frontend/Dockerfile ---
FROM node:18-alpine

WORKDIR /app

# Kopírovanie package.json
COPY frontend/package*.json ./
RUN npm ci

# Kopírovanie kódu
COPY frontend/ .

# Build
RUN npm run build

# Spustenie
CMD ["npm", "start"]

--- docker/nginx/Dockerfile ---
FROM nginx:alpine

# Kopírovanie konfigurácie
COPY docker/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/ssl /etc/nginx/ssl

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

EXPOSE 80 443

--- docker/nginx/conf.d/cmep.conf ---
upstream cmep_api {
    server api:8000;
}
upstream cmep_web {
    server web:3001;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://cmep_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://cmep_api/health;
        proxy_set_header Host $host;
    }

    location /docs {
        proxy_pass http://cmep_api/docs;
        proxy_set_header Host $host;
    }

    location /openapi.json {
        proxy_pass http://cmep_api/openapi.json;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://cmep_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

