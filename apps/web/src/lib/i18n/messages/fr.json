    "terms": "Conditions d'utilisation",
    "privacy": "Protection des données",
    "license": "Licence",
    "copyright": "Tous droits réservés.",
    "faq": {
      "q1": {
        "q": "Qu'est-ce que CMEP ?",
        "a": "CMEP (Circular Materials Exchange Platform) est une bourse B2B pour les matériaux circulaires. Les entreprises échangent des matières premières secondaires, des surplus de production et des sous-produits."
      },
      "q2": {
        "q": "À qui s'adresse la plateforme ?",
        "a": "Aux entreprises ayant un surplus de matériaux (bois, métal, papier, plastiques, biodéchets) et à celles qui recherchent ces matériaux comme intrants."
      },
      "q3": {
        "q": "Comment vérifiez-vous les entreprises ?",
        "a": "Chaque entreprise souhaitant commercer doit passer une vérification du numéro d'enregistrement. La vérification garantit que seules des entreprises sérieuses sont présentes."
      },
      "q4": {
        "q": "Les contacts sont-ils visibles ?",
        "a": "Les contacts (téléphone, e-mail) restent cachés jusqu'à l'accord des entreprises. La communication se fait via le chat interne de la plateforme."
      },
      "q5": {
        "q": "Combien ça coûte ?",
        "a": "L'inscription et l'utilisation de base sont gratuites. Les fonctionnalités premium (priorité d'affichage, annonces illimitées, accès API) seront payantes."
      },
      "q6": {
        "q": "Comment commencer ?",
        "a": "Inscrivez-vous, créez une entreprise, ajoutez votre première annonce. Les autres entreprises vous contacteront directement via la plateforme."
      }
    }
