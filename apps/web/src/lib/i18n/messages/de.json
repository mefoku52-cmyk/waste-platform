    "copyright": "Alle Rechte vorbehalten.",
    "faq": {
      "q1": {
        "q": "Was ist CMEP?",
        "a": "CMEP (Circular Materials Exchange Platform) ist eine B2B-Börse für Kreislaufmaterialien. Unternehmen handeln mit Sekundärrohstoffen, Produktionsüberschüssen und Nebenprodukten."
      },
      "q2": {
        "q": "Für wen ist die Plattform?",
        "a": "Für Unternehmen mit Materialüberschuss (Holz, Metall, Papier, Kunststoffe, Bioabfall) und für Unternehmen, die dieses Material als Input suchen."
      },
      "q3": {
        "q": "Wie überprüfen Sie Unternehmen?",
        "a": "Jedes Unternehmen, das handeln möchte, muss eine Registrierungsnummern-Prüfung durchlaufen. Die Prüfung stellt sicher, dass nur seriöse Unternehmen auf der Plattform sind."
      },
      "q4": {
        "q": "Sind Kontakte sichtbar?",
        "a": "Kontakte (Telefon, E-Mail) bleiben verborgen, bis sich die Unternehmen einigen. Die Kommunikation erfolgt über den internen Plattform-Chat."
      },
      "q5": {
        "q": "Was kostet die Nutzung?",
        "a": "Registrierung und Basisnutzung sind kostenlos. Premium-Funktionen (Listenpriorität, unbegrenzte Angebote, API-Zugang) werden kostenpflichtig."
      },
      "q6": {
        "q": "Wie fange ich an?",
        "a": "Registrieren Sie sich, erstellen Sie ein Unternehmen, fügen Sie Ihr erstes Angebot hinzu. Andere Unternehmen kontaktieren Sie direkt über die Plattform."
      }
    }
