    "copyright": "All rights reserved.",
    "faq": {
      "q1": {
        "q": "What is CMEP?",
        "a": "CMEP (Circular Materials Exchange Platform) is a B2B exchange for circular materials. Companies trade and exchange secondary raw materials, production surpluses and by-products."
      },
      "q2": {
        "q": "Who is the platform for?",
        "a": "For companies with surplus material (wood, metal, paper, plastics, bio waste) and companies looking for this material as input to their production."
      },
      "q3": {
        "q": "How do you verify companies?",
        "a": "Every company that wants to trade must pass a company-ID verification. Verification ensures only serious companies are on the platform."
      },
      "q4": {
        "q": "Are contacts visible?",
        "a": "Contacts (phone, email) stay hidden until companies agree. Communication happens through the internal platform chat."
      },
      "q5": {
        "q": "How much does it cost?",
        "a": "Registration and basic use of the platform are free. Premium features (listing priority, unlimited listings, API access) will be paid."
      },
      "q6": {
        "q": "How do I start?",
        "a": "Register, create a company, add your first listing. Other companies will contact you directly through the platform."
      }
    }
