'use client';

import { Logo } from "@/components/brand/logo";
import { AppShell } from "@/components/layout/app-shell";
import { MatchesPanel, ListingsTable, MarketplaceTable } from "@/features/listings";
import { ComplianceTable } from "@/features/compliance";
import { AuditTable } from "@/features/admin";
import { DocumentsTable } from "@/features/documents";
import { useAuthRequired, useLogout } from "@/features/auth";
import { Button } from "@/components/ui/button";
import { NotificationsPanel } from "@/features/notifications";
import { InquiriesTable } from "@/features/inquiries";
import { CompaniesTable } from "@/features/companies";
import { useRouter } from "next/navigation";

const nav = [
  { href: "#prehled", label: "Prehľad" },
  { href: "#ponuky", label: "Ponuky" },
  { href: "#trhovisko", label: "Trhovisko" },
  { href: "#zhody", label: "Zhody" },
  { href: "#odoslane", label: "Odoslané" },
  { href: "#firmy", label: "Firmy" },
  { href: "#dokumenty", label: "Dokumenty" },
];

function PanelSection({
  id,
  eyebrow,
  title,
  subtitle,
  action,
  children,
}: {
  id: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  action?: React.ReactNode;
  children: React.ReactNode;
}) {
  return (
    <section id={id} className="scroll-mt-28 border-b border-slate-700/70 py-4 first:pt-0 last:border-b-0 last:pb-0">
      <div className="mb-3 flex flex-wrap items-start justify-between gap-2">
        <div className="min-w-0">
          {eyebrow ? (
            <p className="mb-1 text-[10px] font-semibold uppercase tracking-wider text-emerald-300">
              {eyebrow}
            </p>
          ) : null}
          <h2 className="text-sm font-semibold text-white">{title}</h2>
          {subtitle ? (
            <p className="mt-0.5 text-[11px] text-slate-400">{subtitle}</p>
          ) : null}
        </div>
        {action}
      </div>

      <div className="min-w-0">{children}</div>
    </section>
  );
}

export default function DashboardPage() {
  const { user, isLoading } = useAuthRequired();
  const { mutate: logout, isPending: isLoggingOut } = useLogout();
  const router = useRouter();

  if (isLoading) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-slate-950">
        <div className="text-sm font-medium text-slate-300">Načítavam…</div>
      </div>
    );
  }

  return (
    <AppShell
      header={
        <header className="sticky top-0 z-40 border-b border-slate-800 bg-slate-950/95 text-slate-100 backdrop-blur-md">
          <div className="mx-auto flex max-w-6xl items-center justify-between gap-3 px-3 py-3 sm:px-6">
            <div className="flex min-w-0 items-center gap-2.5 sm:gap-3">
              <Logo size="sm" showText={false} className="shrink-0" />

              <div className="min-w-0">
                <p className="text-[10px] font-semibold uppercase tracking-wider text-emerald-300">
                  CMEP
                </p>
                <h1 className="truncate text-base font-bold text-white sm:text-xl">
                  Obehové materiály
                </h1>

                {user?.role === "admin" && (
                  <button
                    type="button"
                    onClick={() => router.push("/dashboard/admin")}
                    className="mt-0.5 text-[11px] font-medium text-emerald-300 transition hover:text-emerald-200 hover:underline"
                  >
                    Admin panel →
                  </button>
                )}
              </div>
            </div>

            <div className="flex shrink-0 items-center gap-2 sm:gap-3">
              <div className="hidden text-right sm:block">
                <p className="max-w-[200px] truncate text-sm font-medium text-slate-100">
                  {user?.email}
                </p>
                <p className="text-[10px] capitalize text-slate-400">
                  {user?.role || "user"}
                </p>
              </div>

              <Button
                variant="outline"
                size="sm"
                className="border-slate-600 bg-slate-900 text-slate-100 hover:border-slate-500 hover:bg-slate-800"
                onClick={() => logout()}
                disabled={isLoggingOut}
              >
                {isLoggingOut ? "…" : "Odhlásiť"}
              </Button>
            </div>
          </div>

          <div className="border-t border-slate-800">
            <nav className="mx-auto flex max-w-6xl gap-2 overflow-x-auto px-3 py-2.5 scrollbar-none sm:px-6">
              {nav.map((item) => (
                <a
                  key={item.href}
                  href={item.href}
                  className="shrink-0 rounded-full border border-slate-700 bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-slate-200 shadow-sm transition hover:border-emerald-400 hover:bg-emerald-950 hover:text-emerald-200 active:scale-[0.98]"
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </div>
        </header>
      }
    >
      <main className="min-h-screen bg-slate-950 px-3 py-4 text-slate-100 sm:px-6 sm:py-6">
        <div className="mx-auto max-w-6xl">
          <div
            id="prehled"
            className="rounded-2xl border border-slate-700/80 bg-slate-950/95 p-4 shadow-xl shadow-black/30 sm:p-6"
          >
            <PanelSection
              id="notifikacie"
              eyebrow="IN · Centrum aktivít"
              title="Notifikácie"
              subtitle="Aktuálne upozornenia, nové reakcie a zmeny vo vašom účte"
            >
              <NotificationsPanel />
            </PanelSection>

            <PanelSection
              id="prijate"
              eyebrow="RD · Reakcie na vaše ponuky"
              title="Prijaté dopyty"
              subtitle="Firmy alebo používatelia, ktorí prejavili záujem o vaše materiály"
            >
              <InquiriesTable mode="received" />
            </PanelSection>

            <PanelSection
              id="ponuky"
              eyebrow="AP · Správa materiálov"
              title="Aktuálne ponuky"
              subtitle="Ponuky materiálov, ktoré ste vytvorili a spravujete"
              action={
                <Button
                  size="sm"
                  className="bg-emerald-600 text-white hover:bg-emerald-500"
                  onClick={() => router.push("/dashboard/listings/new")}
                >
                  + Pridať ponuku
                </Button>
              }
            >
              <ListingsTable />
            </PanelSection>

            <PanelSection
              id="trhovisko"
              eyebrow="TR · Objavovanie"
              title="Trhovisko"
              subtitle="Publikované ponuky materiálov od iných firiem"
            >
              <div className="rounded-xl border border-emerald-900/60 bg-emerald-950/20 p-2 sm:p-3">
                <MarketplaceTable />
              </div>
            </PanelSection>

            <PanelSection
              id="zhody"
              eyebrow="ZH · Odporúčania"
              title="Odporúčané zhody"
              subtitle="Relevantné materiály podľa typu vašich vlastných ponúk"
            >
              <MatchesPanel />
            </PanelSection>

            <PanelSection
              id="odoslane"
              eyebrow="OD · Komunikácia"
              title="Odoslané dopyty"
              subtitle="Dopyty, ktoré ste odoslali iným firmám"
            >
              <InquiriesTable mode="sent" />
            </PanelSection>

            <PanelSection
              id="firmy"
              eyebrow="FI · Partneri"
              title="Registrované firmy"
              subtitle="Firmy, s ktorými môžete spolupracovať alebo ich evidovať"
              action={
                <Button
                  size="sm"
                  variant="secondary"
                  onClick={() => router.push("/dashboard/companies/new")}
                >
                  + Pridať firmu
                </Button>
              }
            >
              <CompaniesTable />
            </PanelSection>

            <PanelSection
              id="dokumenty"
              eyebrow="DO · Evidencia"
              title="Dokumenty"
              subtitle="Súbory, potvrdenia a dokumentácia súvisiaca s materiálmi"
              action={
                <Button
                  size="sm"
                  variant="secondary"
                  onClick={() => router.push("/dashboard/documents/new")}
                >
                  + Pridať dokument
                </Button>
              }
            >
              <DocumentsTable />
            </PanelSection>

            {user?.role === "admin" && (
              <>
                <PanelSection
                  id="audit"
                  eyebrow="AD · Administrácia"
                  title="Audit log"
                  subtitle="Systémový prehľad aktivít"
                >
                  <AuditTable />
                </PanelSection>

                <PanelSection
                  id="compliance"
                  eyebrow="AD · Administrácia"
                  title="Compliance"
                  subtitle="Kontrola povinností a pravidiel"
                >
                  <ComplianceTable />
                </PanelSection>
              </>
            )}
          </div>

          <p className="pb-3 pt-4 text-center text-[11px] text-slate-500">
            CMEP · lokálny vývoj
          </p>
        </div>
      </main>
    </AppShell>
  );
}
