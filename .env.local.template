# =============================================================================
# CMEP — Local Development Environment
# =============================================================================
# Tento subor sluzi pre lokalny development.
# Pre produkciu pouzi .env.production (NEcommituj!)
# =============================================================================

APP_ENV=development
APP_NAME=CMEP Dev
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cmep_dev
POSTGRES_USER=cmep_dev
POSTGRES_PASSWORD=dev_password_change_me

DATABASE_URL=postgresql+asyncpg://cmep_dev:dev_password_change_me@localhost:5432/cmep_dev

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET_KEY=dev-secret-key-min-32-characters-long
JWT_REFRESH_SECRET_KEY=dev-refresh-key-min-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","*.localhost"]

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_SECURE=false
S3_BUCKET_NAME=cmep-dev-documents
S3_ENDPOINT_URL=http://localhost:9000

EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=dev@cmep.local
EMAIL_TLS=false

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60

PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc_dev
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

GDPR_ENABLED=false
GDPR_COOKIE_CONSENT=false
