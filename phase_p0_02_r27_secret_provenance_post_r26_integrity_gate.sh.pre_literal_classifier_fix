#!/data/data/com.termux/files/usr/bin/bash
set -u
set -o pipefail

PROJECT_ROOT="${HOME}/waste-platform"
REPORT="${PROJECT_ROOT}/audit-output/p0_02_r27_secret_provenance_post_r26_integrity_gate.txt"

mkdir -p "${PROJECT_ROOT}/audit-output"

FAILURE_COUNT=0
REVIEW_COUNT=0

log() {
    printf '%s\n' "$*" | tee -a "${REPORT}"
}

fail() {
    FAILURE_COUNT=$((FAILURE_COUNT + 1))
    log "FAIL: $*"
}

review() {
    REVIEW_COUNT=$((REVIEW_COUNT + 1))
    log "REVIEW: $*"
}

: > "${REPORT}"

log "============================================================"
log "P0-02 R27 SECRET PROVENANCE POST-R26 INTEGRITY GATE"
log "============================================================"
log ""

# ============================================================
# 1. SAFETY PRECHECK
# ============================================================

log "1. SAFETY PRECHECK"

if [ -d "${PROJECT_ROOT}" ]; then
    log "PASS: PROJECT_ROOT_CONFIRMED=${PROJECT_ROOT}"
else
    fail "PROJECT_ROOT_MISSING=${PROJECT_ROOT}"
fi

log "PASS: READ_ONLY=YES"
log "PASS: NO_SOURCE_WRITES=YES"
log "PASS: NO_RUNTIME_EXECUTION=YES"
log "PASS: NO_ENV_EXECUTION=YES"
log "PASS: NO_BUILD=YES"
log "PASS: NO_DEPLOYMENT=YES"
log "PASS: NO_DELETIONS=YES"
log "PASS: NO_SECRET_VALUES_PRINTED=YES"
log "PASS: BOUNDED_SCAN=YES"
log ""

# ============================================================
# 2. REQUIRED AUTHORITY FILES
# ============================================================

log "2. REQUIRED AUTHORITY FILES"

REQUIRED_FILES=(
    ".env.production"
    "docker-compose.yml"
    "app/core/config.py"
    ".github/workflows/ci.yml"
    "scripts/deploy.sh"
)

for rel in "${REQUIRED_FILES[@]}"; do
    if [ -f "${PROJECT_ROOT}/${rel}" ]; then
        log "PASS: AUTHORITY_PRESENT=${rel}"
    else
        fail "AUTHORITY_MISSING=${rel}"
    fi
done

log ""

# ============================================================
# 3. R26 REPORT AVAILABILITY
# ============================================================

log "3. R26 REPORT AVAILABILITY"

R26_REPORT="${PROJECT_ROOT}/audit-output/p0_02_r26_secret_provenance_ground_truth_parser.txt"

if [ -f "${R26_REPORT}" ]; then
    log "PASS: R26_REPORT_PRESENT"
else
    fail "R26_REPORT_MISSING"
fi

if [ -f "${R26_REPORT}" ]; then
    if grep -Fq 'P0_02_R26_STATUS=CLEAN' "${R26_REPORT}"; then
        log "PASS: R26_STATUS_CLEAN"
    else
        fail "R26_STATUS_NOT_CLEAN"
    fi

    if grep -Fq 'EXIT_CODE=0' "${R26_REPORT}"; then
        log "PASS: R26_EXIT_CODE_ZERO"
    else
        fail "R26_EXIT_CODE_NOT_ZERO"
    fi

    if grep -Fq 'FAILURE_COUNT=0' "${R26_REPORT}"; then
        log "PASS: R26_FAILURE_COUNT_ZERO"
    else
        fail "R26_FAILURE_COUNT_NONZERO"
    fi

    if grep -Fq 'REVIEW_COUNT=0' "${R26_REPORT}"; then
        log "PASS: R26_REVIEW_COUNT_ZERO"
    else
        fail "R26_REVIEW_COUNT_NONZERO"
    fi
fi

log ""

# ============================================================
# 4. PRODUCTION SECRET AUTHORITY CARDINALITY
# ============================================================

log "4. PRODUCTION SECRET AUTHORITY CARDINALITY"

SECRET_TOKENS=(
    "POSTGRES_PASSWORD"
    "DATABASE_PASSWORD"
    "JWT_SECRET_KEY"
    "JWT_REFRESH_SECRET_KEY"
    "S3_SECRET_KEY"
)

ENV_FILE="${PROJECT_ROOT}/.env.production"

ENV_SECRET_COUNT=0
ENV_MISSING_COUNT=0

for key in "${SECRET_TOKENS[@]}"; do
    if [ -f "${ENV_FILE}" ] && \
       grep -Eq "^[[:space:]]*${key}[[:space:]]*=" "${ENV_FILE}"; then
        ENV_SECRET_COUNT=$((ENV_SECRET_COUNT + 1))
        log "PASS: ENV_AUTHORITY_PRESENT KEY=${key} VALUE=<REDACTED>"
    else
        ENV_MISSING_COUNT=$((ENV_MISSING_COUNT + 1))
        fail "ENV_AUTHORITY_MISSING KEY=${key}"
    fi
done

log "ENV_SECRET_COUNT=${ENV_SECRET_COUNT}"
log "ENV_MISSING_COUNT=${ENV_MISSING_COUNT}"

if [ "${ENV_SECRET_COUNT}" -eq 5 ] && [ "${ENV_MISSING_COUNT}" -eq 0 ]; then
    log "PASS: PRODUCTION_SECRET_AUTHORITY_EXACT"
else
    fail "PRODUCTION_SECRET_AUTHORITY_NOT_EXACT"
fi

log ""

# ============================================================
# 5. COMPOSE STRUCTURAL INTEGRITY
# ============================================================

log "5. COMPOSE STRUCTURAL INTEGRITY"

COMPOSE_FILE="${PROJECT_ROOT}/docker-compose.yml"

COMPOSE_REFERENCE_COUNT=0
COMPOSE_LITERAL_COUNT=0
COMPOSE_TARGET_COUNT=0

if [ -f "${COMPOSE_FILE}" ]; then

    if grep -Eq 'POSTGRES_PASSWORD[[:space:]]*:[[:space:]]*"?\$\{POSTGRES_PASSWORD' "${COMPOSE_FILE}"; then
        COMPOSE_TARGET_COUNT=$((COMPOSE_TARGET_COUNT + 1))
        COMPOSE_REFERENCE_COUNT=$((COMPOSE_REFERENCE_COUNT + 1))
        log "PASS: COMPOSE_REFERENCE_WIRING KEY=POSTGRES_PASSWORD"
    else
        fail "COMPOSE_REFERENCE_MISSING KEY=POSTGRES_PASSWORD"
    fi

    if grep -Eq 'JWT_SECRET_KEY[[:space:]]*:[[:space:]]*"?\$\{JWT_SECRET_KEY' "${COMPOSE_FILE}"; then
        COMPOSE_TARGET_COUNT=$((COMPOSE_TARGET_COUNT + 1))
        COMPOSE_REFERENCE_COUNT=$((COMPOSE_REFERENCE_COUNT + 1))
        log "PASS: COMPOSE_REFERENCE_WIRING KEY=JWT_SECRET_KEY"
    else
        fail "COMPOSE_REFERENCE_MISSING KEY=JWT_SECRET_KEY"
    fi

    if grep -Eq 'JWT_REFRESH_SECRET_KEY[[:space:]]*:[[:space:]]*"?\$\{JWT_REFRESH_SECRET_KEY' "${COMPOSE_FILE}"; then
        COMPOSE_TARGET_COUNT=$((COMPOSE_TARGET_COUNT + 1))
        COMPOSE_REFERENCE_COUNT=$((COMPOSE_REFERENCE_COUNT + 1))
        log "PASS: COMPOSE_REFERENCE_WIRING KEY=JWT_REFRESH_SECRET_KEY"
    else
        fail "COMPOSE_REFERENCE_MISSING KEY=JWT_REFRESH_SECRET_KEY"
    fi

    if grep -Eq 'DATABASE_URL:.*\$\{POSTGRES_PASSWORD' "${COMPOSE_FILE}"; then
        log "PASS: DATABASE_URL_POSTGRES_PASSWORD_INTERPOLATION_PRESENT"
    else
        fail "DATABASE_URL_POSTGRES_PASSWORD_INTERPOLATION_MISSING"
    fi

    if grep -Eq '^[[:space:]]*(POSTGRES_PASSWORD|DATABASE_PASSWORD|JWT_SECRET_KEY|JWT_REFRESH_SECRET_KEY|S3_SECRET_KEY)[[:space:]]*:[[:space:]]*[^$]' "${COMPOSE_FILE}"; then
        COMPOSE_LITERAL_COUNT=$(
            grep -E '^[[:space:]]*(POSTGRES_PASSWORD|DATABASE_PASSWORD|JWT_SECRET_KEY|JWT_REFRESH_SECRET_KEY|S3_SECRET_KEY)[[:space:]]*:[[:space:]]*[^$]' \
            "${COMPOSE_FILE}" | wc -l | tr -d ' '
        )
    fi
fi

log "COMPOSE_TARGET_COUNT=${COMPOSE_TARGET_COUNT}"
log "COMPOSE_REFERENCE_COUNT=${COMPOSE_REFERENCE_COUNT}"
log "COMPOSE_LITERAL_COUNT=${COMPOSE_LITERAL_COUNT}"

if [ "${COMPOSE_TARGET_COUNT}" -eq 3 ]; then
    log "PASS: COMPOSE_TARGET_CARDINALITY_EXACT"
else
    fail "COMPOSE_TARGET_CARDINALITY_CHANGED"
fi

if [ "${COMPOSE_REFERENCE_COUNT}" -eq 3 ]; then
    log "PASS: COMPOSE_REFERENCE_CARDINALITY_EXACT"
else
    fail "COMPOSE_REFERENCE_CARDINALITY_CHANGED"
fi

if [ "${COMPOSE_LITERAL_COUNT}" -eq 0 ]; then
    log "PASS: NO_LITERAL_COMPOSE_SECRET_ASSIGNMENT"
else
    fail "LITERAL_COMPOSE_SECRET_ASSIGNMENT_DETECTED"
fi

log ""

# ============================================================
# 6. RUNTIME SECRET BOUNDARY
# ============================================================

log "6. RUNTIME SECRET BOUNDARY"

CONFIG_FILE="${PROJECT_ROOT}/app/core/config.py"

RUNTIME_DECLARATION_COUNT=0
RUNTIME_LITERAL_COUNT=0

if [ -f "${CONFIG_FILE}" ]; then

    if grep -Eq 'JWT_SECRET_KEY' "${CONFIG_FILE}"; then
        log "PASS: RUNTIME_JWT_SECRET_IDENTIFIER_PRESENT"
    else
        fail "RUNTIME_JWT_SECRET_IDENTIFIER_MISSING"
    fi

    RUNTIME_DECLARATION_COUNT=$(
        grep -Ec 'JWT_SECRET_KEY[[:space:]]*=' "${CONFIG_FILE}" || true
    )

    if grep -Eq 'os\.getenv|os\.environ|getenv|Settings|BaseSettings' "${CONFIG_FILE}"; then
        log "PASS: RUNTIME_SECRET_AUTHORITY_CONTEXT_PRESENT"
    else
        review "RUNTIME_SECRET_AUTHORITY_CONTEXT_NOT_CONFIRMED"
    fi

    if grep -Eq 'JWT_SECRET_KEY[[:space:]]*=[[:space:]]*["'\'']' "${CONFIG_FILE}"; then
        RUNTIME_LITERAL_COUNT=$(
            grep -Ec 'JWT_SECRET_KEY[[:space:]]*=[[:space:]]*["'\'']' "${CONFIG_FILE}" || true
        )
    fi
fi

log "RUNTIME_DECLARATION_COUNT=${RUNTIME_DECLARATION_COUNT}"
log "RUNTIME_LITERAL_COUNT=${RUNTIME_LITERAL_COUNT}"

if [ "${RUNTIME_LITERAL_COUNT}" -eq 0 ]; then
    log "PASS: NO_LITERAL_RUNTIME_SECRET"
else
    fail "LITERAL_RUNTIME_SECRET_ASSIGNMENT_DETECTED"
fi

log ""

# ============================================================
# 7. CI SECRET SCOPE
# ============================================================

log "7. CI SECRET SCOPE"

CI_FILE="${PROJECT_ROOT}/.github/workflows/ci.yml"

CI_SECRET_ASSIGNMENT_COUNT=0
CI_PROD_SCOPE_COUNT=0

if [ -f "${CI_FILE}" ]; then

    for key in "${SECRET_TOKENS[@]}"; do
        if grep -Eq "${key}" "${CI_FILE}"; then
            CI_SECRET_ASSIGNMENT_COUNT=$((CI_SECRET_ASSIGNMENT_COUNT + 1))
            log "PASS: CI_SECRET_IDENTIFIER_PRESENT KEY=${key}"
        fi
    done

    if grep -Eiq 'production|prod|deploy' "${CI_FILE}"; then
        CI_PROD_SCOPE_COUNT=$(
            grep -Eic 'production|prod|deploy' "${CI_FILE}" || true
        )
    fi
fi

log "CI_SECRET_ASSIGNMENT_COUNT=${CI_SECRET_ASSIGNMENT_COUNT}"
log "CI_PROD_SCOPE_COUNT=${CI_PROD_SCOPE_COUNT}"

if [ "${CI_SECRET_ASSIGNMENT_COUNT}" -eq 5 ]; then
    log "PASS: CI_SECRET_ASSIGNMENT_SET_EXACT"
else
    fail "CI_SECRET_ASSIGNMENT_SET_CHANGED"
fi

log ""

# ============================================================
# 8. DEPLOYMENT BOUNDARY
# ============================================================

log "8. DEPLOYMENT BOUNDARY"

DEPLOY_FILE="${PROJECT_ROOT}/scripts/deploy.sh"
DEPLOY_SECRET_REFERENCE_COUNT=0

if [ -f "${DEPLOY_FILE}" ]; then
    for key in "${SECRET_TOKENS[@]}"; do
        if grep -Eq "${key}" "${DEPLOY_FILE}"; then
            DEPLOY_SECRET_REFERENCE_COUNT=$((DEPLOY_SECRET_REFERENCE_COUNT + 1))
        fi
    done
fi

log "DEPLOY_SECRET_REFERENCE_COUNT=${DEPLOY_SECRET_REFERENCE_COUNT}"

if [ "${DEPLOY_SECRET_REFERENCE_COUNT}" -eq 0 ]; then
    log "PASS: DEPLOYMENT_NO_DIRECT_SECRET_REFERENCE"
else
    fail "DEPLOYMENT_DIRECT_SECRET_REFERENCE_DETECTED"
fi

log ""

# ============================================================
# 9. SECRET OUTPUT GUARD
# ============================================================

log "9. SECRET OUTPUT GUARD"

SECRET_VALUE_OUTPUT_COUNT=0

for file in \
    "${COMPOSE_FILE}" \
    "${CONFIG_FILE}" \
    "${CI_FILE}" \
    "${DEPLOY_FILE}"
do
    [ -f "${file}" ] || continue

    if grep -Eq 'echo[[:space:]].*(POSTGRES_PASSWORD|DATABASE_PASSWORD|JWT_SECRET_KEY|JWT_REFRESH_SECRET_KEY|S3_SECRET_KEY)' "${file}"; then
        SECRET_VALUE_OUTPUT_COUNT=$((SECRET_VALUE_OUTPUT_COUNT + 1))
    fi
done

log "SECRET_VALUE_OUTPUT_COUNT=${SECRET_VALUE_OUTPUT_COUNT}"

if [ "${SECRET_VALUE_OUTPUT_COUNT}" -eq 0 ]; then
    log "PASS: SECRET_VALUE_OUTPUT_REMAINED_REDACTED"
else
    fail "SECRET_VALUE_OUTPUT_PATTERN_DETECTED"
fi

log ""

# ============================================================
# 10. R26 BASELINE RECONCILIATION
# ============================================================

log "10. R26 BASELINE RECONCILIATION"

R26_COMPOSE_REFERENCE_BASELINE=3
R26_COMPOSE_LITERAL_BASELINE=0
R26_SECRET_OUTPUT_BASELINE=0

log "R26_COMPOSE_REFERENCE_BASELINE=${R26_COMPOSE_REFERENCE_BASELINE}"
log "R26_COMPOSE_LITERAL_BASELINE=${R26_COMPOSE_LITERAL_BASELINE}"
log "R26_SECRET_OUTPUT_BASELINE=${R26_SECRET_OUTPUT_BASELINE}"

if [ "${COMPOSE_REFERENCE_COUNT}" -eq "${R26_COMPOSE_REFERENCE_BASELINE}" ]; then
    log "PASS: R26_COMPOSE_REFERENCE_BASELINE_PRESERVED"
else
    fail "R26_COMPOSE_REFERENCE_BASELINE_DRIFT"
fi

if [ "${COMPOSE_LITERAL_COUNT}" -eq "${R26_COMPOSE_LITERAL_BASELINE}" ]; then
    log "PASS: R26_COMPOSE_LITERAL_BASELINE_PRESERVED"
else
    fail "R26_COMPOSE_LITERAL_BASELINE_DRIFT"
fi

if [ "${SECRET_VALUE_OUTPUT_COUNT}" -eq "${R26_SECRET_OUTPUT_BASELINE}" ]; then
    log "PASS: R26_SECRET_OUTPUT_BASELINE_PRESERVED"
else
    fail "R26_SECRET_OUTPUT_BASELINE_DRIFT"
fi

log ""

# ============================================================
# 11. FINAL INVARIANTS
# ============================================================

log "11. FINAL INVARIANTS"

if [ "${ENV_SECRET_COUNT}" -eq 5 ] &&
   [ "${ENV_MISSING_COUNT}" -eq 0 ]; then
    log "PASS: INVARIANT_PRODUCTION_SECRET_SET_EXACT"
else
    fail "INVARIANT_PRODUCTION_SECRET_SET_BROKEN"
fi

if [ "${COMPOSE_REFERENCE_COUNT}" -eq 3 ] &&
   [ "${COMPOSE_LITERAL_COUNT}" -eq 0 ]; then
    log "PASS: INVARIANT_COMPOSE_SECRET_LINEAGE"
else
    fail "INVARIANT_COMPOSE_SECRET_LINEAGE_BROKEN"
fi

if [ "${RUNTIME_LITERAL_COUNT}" -eq 0 ]; then
    log "PASS: INVARIANT_NO_LITERAL_RUNTIME_SECRET"
else
    fail "INVARIANT_NO_LITERAL_RUNTIME_SECRET_BROKEN"
fi

if [ "${DEPLOY_SECRET_REFERENCE_COUNT}" -eq 0 ]; then
    log "PASS: INVARIANT_DEPLOYMENT_BOUNDARY"
else
    fail "INVARIANT_DEPLOYMENT_BOUNDARY_BROKEN"
fi

if [ "${SECRET_VALUE_OUTPUT_COUNT}" -eq 0 ]; then
    log "PASS: INVARIANT_NO_SECRET_VALUE_OUTPUT"
else
    fail "INVARIANT_SECRET_VALUE_OUTPUT_BROKEN"
fi

log ""

# ============================================================
# 12. FINAL CLASSIFICATION
# ============================================================

log "12. FINAL CLASSIFICATION"

log "FAILURE_COUNT=${FAILURE_COUNT}"
log "REVIEW_COUNT=${REVIEW_COUNT}"
log "ENV_SECRET_COUNT=${ENV_SECRET_COUNT}"
log "COMPOSE_TARGET_COUNT=${COMPOSE_TARGET_COUNT}"
log "COMPOSE_REFERENCE_COUNT=${COMPOSE_REFERENCE_COUNT}"
log "COMPOSE_LITERAL_COUNT=${COMPOSE_LITERAL_COUNT}"
log "RUNTIME_DECLARATION_COUNT=${RUNTIME_DECLARATION_COUNT}"
log "RUNTIME_LITERAL_COUNT=${RUNTIME_LITERAL_COUNT}"
log "CI_SECRET_ASSIGNMENT_COUNT=${CI_SECRET_ASSIGNMENT_COUNT}"
log "CI_PROD_SCOPE_COUNT=${CI_PROD_SCOPE_COUNT}"
log "DEPLOY_SECRET_REFERENCE_COUNT=${DEPLOY_SECRET_REFERENCE_COUNT}"
log "SECRET_VALUE_OUTPUT_COUNT=${SECRET_VALUE_OUTPUT_COUNT}"

if [ "${FAILURE_COUNT}" -gt 0 ]; then
    STATUS="FAIL"
    RESULT="P0_02_R27_SECRET_PROVENANCE_POST_R26_INTEGRITY_FAILED"
    EXIT_CODE=20
elif [ "${REVIEW_COUNT}" -gt 0 ]; then
    STATUS="REVIEW"
    RESULT="P0_02_R27_SECRET_PROVENANCE_POST_R26_INTEGRITY_REVIEW_REQUIRED"
    EXIT_CODE=10
else
    STATUS="CLEAN"
    RESULT="P0_02_R27_SECRET_PROVENANCE_POST_R26_INTEGRITY_CLEAN"
    EXIT_CODE=0
fi

log "P0_02_R27_STATUS=${STATUS}"
log "RESULT=${RESULT}"
log "EXIT_CODE=${EXIT_CODE}"
log "REPORT=${REPORT}"

exit "${EXIT_CODE}"
