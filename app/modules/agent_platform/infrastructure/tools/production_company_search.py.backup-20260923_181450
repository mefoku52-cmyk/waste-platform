"""Production composition for the existing CMEP company-search tool.

This module deliberately does not create:
- a second router,
- a second company-search service,
- a second repository,
- an alternate authorization system,
- a parallel AgentRuntime.

Authentication and company scope must come from the existing CMEP
application boundary.
"""

from collections.abc import Sequence

from app.modules.companies.application.services import ListCompaniesService

from .handler_adapters import CompanySearchToolHandler
from .phase5_tool_wiring import build_phase5_executor


def build_production_company_search_executor(
    *,
    service: ListCompaniesService,
    is_platform_admin: bool,
    company_ids: Sequence[str] | None = None,
):
    """Compose the existing Phase 5 executor with CMEP company search.

    Authorization is supplied by the authenticated CMEP application
    boundary. This function never accepts company_ids from tool arguments.
    """

    handler = CompanySearchToolHandler(
        service=service,
        is_platform_admin=is_platform_admin,
        company_ids=tuple(company_ids or ()),
    )

    return build_phase5_executor(
        handler_overrides={
            "cmep.company.search": handler,
        },
    )
