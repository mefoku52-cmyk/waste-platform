from fastapi import APIRouter, Depends, HTTPException, status
from typing import List, Dict, Any
from app.shared.security import get_current_user, require_role, require_permission

router = APIRouter(prefix="/inquiries", tags=["inquiries"])

# In-memory storage
_items = []
_counter = 0

@router.get("/")
async def get_all(current_user: Dict[str, Any] = Depends(get_current_user)):
    """Získa všetky inquiries (prihlásený používateľ)"""
    # Admin vidí všetko, bežný používateľ len svoje
    if current_user.get("role") == "admin":
        return _items
    else:
        # Vráti len položky, ktoré patria používateľovi
        return [item for item in _items if item.get("user_id") == current_user["id"]]

@router.post("/", status_code=status.HTTP_201_CREATED)
async def create(
    data: Dict[str, Any],
    current_user: Dict[str, Any] = Depends(require_permission("write_own"))
):
    """Vytvorí novú inquiry (vyžaduje write_own)"""
    global _counter
    _counter += 1
    item = {
        "id": _counter,
        "user_id": current_user["id"],
        "created_by": current_user["email"],
        **data
    }
    _items.append(item)
    return item

@router.get("/{id}")
async def get_by_id(
    id: int,
    current_user: Dict[str, Any] = Depends(get_current_user)
):
    """Získa inquiry podľa ID (kontrola vlastníctva)"""
    for item in _items:
        if item.get("id") == id:
            # Admin vidí všetko, bežný používateľ len svoje
            if current_user.get("role") == "admin" or item.get("user_id") == current_user["id"]:
                return item
            raise HTTPException(status_code=403, detail="Access denied")
    raise HTTPException(status_code=404, detail="Item not found")

@router.put("/{id}")
async def update(
    id: int,
    data: Dict[str, Any],
    current_user: Dict[str, Any] = Depends(require_permission("write_own"))
):
    """Aktualizuje inquiry (len vlastník alebo admin)"""
    for i, item in enumerate(_items):
        if item.get("id") == id:
            # Admin alebo vlastník
            if current_user.get("role") == "admin" or item.get("user_id") == current_user["id"]:
                updated = {**item, **data}
                _items[i] = updated
                return updated
            raise HTTPException(status_code=403, detail="Access denied")
    raise HTTPException(status_code=404, detail="Item not found")

@router.delete("/{id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete(
    id: int,
    current_user: Dict[str, Any] = Depends(require_permission("write_own"))
):
    """Vymaže inquiry (len vlastník alebo admin)"""
    for i, item in enumerate(_items):
        if item.get("id") == id:
            if current_user.get("role") == "admin" or item.get("user_id") == current_user["id"]:
                del _items[i]
                return
            raise HTTPException(status_code=403, detail="Access denied")
    raise HTTPException(status_code=404, detail="Item not found")
