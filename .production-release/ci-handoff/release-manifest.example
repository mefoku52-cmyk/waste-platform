# Immutable production release manifest example.
#
# This is a contract/example only.
# It must never contain secrets.
#
RELEASE_ID=sha-<GITHUB_SHA>
IMAGE_TAG=release-<GITHUB_SHA>

API_IMAGE=cmep-api:${IMAGE_TAG}
WORKER_IMAGE=cmep-worker:${IMAGE_TAG}
WEB_IMAGE=cmep-web:${IMAGE_TAG>

SOURCE_REVISION=<GITHUB_SHA>
CREATED_AT=<CI_TIMESTAMP>

MANIFEST_FORMAT_VERSION=1
