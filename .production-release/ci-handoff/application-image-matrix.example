# Production application image identity matrix.
#
# All application images belonging to one release MUST share the
# same IMAGE_TAG.

API_IMAGE=cmep-api:${IMAGE_TAG}
WORKER_IMAGE=cmep-worker:${IMAGE_TAG}
WEB_IMAGE=cmep-web:${IMAGE_TAG}

IMAGE_IDENTITY_RULE=ONE_RELEASE_ONE_IMAGE_TAG
MUTABLE_TAGS_FORBIDDEN=latest,dev,test,current
MATRIX_FORMAT_VERSION=1
