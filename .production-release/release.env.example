# Production release identity contract.
#
# This file is intentionally an EXAMPLE only.
# Never place secrets here.
#
# Production automation must provide:
#
# RELEASE_ID
# IMAGE_TAG
#
# Recommended:
#
# RELEASE_ID=<immutable CI release identifier>
# IMAGE_TAG=<immutable image tag derived from RELEASE_ID>
#
# Example:
#
# RELEASE_ID=sha-<commit-sha>
# IMAGE_TAG=release-<commit-sha>
#
# Do not use:
#
# latest
# dev
# test
# current
#
# A deployment must fail closed when RELEASE_ID or IMAGE_TAG
# is missing or invalid.
#
RELEASE_ID=
IMAGE_TAG=

# Non-secret production image namespace.
# Replace <github-owner> with the GitHub repository owner.
REGISTRY_IMAGE_PREFIX=ghcr.io/<github-owner>
