# Canonical environment contract. Copy to an untracked .env locally.
# Never commit real values.

APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001

DATABASE_URL=postgresql+asyncpg://waste:change-me@127.0.0.1:5432/waste
REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001/api/v1
IMAGE_TAG=dev
