# Canonical environment contract. Copy to an untracked .env locally.
# Never commit real values.

# --- Runtime environment ---
# development | test | production. In production DEBUG/ENABLE_PUBLIC_DOCS
# default to false and insecure JWT secrets / SQLite are rejected at startup.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
# Optional ASGI root path when served behind a path prefix (default empty).
ROOT_PATH=
# Optional explicit overrides (default: false outside development).
# DEBUG=false
# ENABLE_PUBLIC_DOCS=false
# ENABLE_METRICS=false

# --- Database (PostgreSQL required outside development) ---
DATABASE_URL=postgresql+asyncpg://waste:change-me@127.0.0.1:5432/waste
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth / JWT ---
# JWT_SECRET_KEY is the canonical name (JWT_SECRET is accepted as an alias).
# Outside development the value must be >= 32 chars and not a placeholder.
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
# Minute/day variants (used only when the *_TTL_SECONDS above are unset).
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Platform admin allowlist (global operators) ---
# Tenant/company ADMIN roles are NOT platform admins.
PLATFORM_ADMIN_EMAILS=admin@cmep.dev

# --- CORS (CORS_ALLOWED_ORIGINS is accepted as an alias) ---
CORS_ORIGINS=https://trc-cmep.sk,https://www.trc-cmep.sk,http://127.0.0.1:3001,http://localhost:3001

# --- Rate limiting (login / forgot-password brute-force protection) ---
# Keep enabled in production. Requires a reachable Redis for shared state;
# without it the limiter falls back to per-process memory.
RATE_LIMIT_ENABLED=true

# --- Frontend ---
# Build-time for Next.js. A relative value makes the browser use the same-origin
# server proxy (apps/web/next.config.js rewrites /api/v1/* to API_PROXY_TARGET).
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Build-time target of the Next.js server-side API proxy. In docker-compose this
# is the service name; on Render set it to the internal URL of the API service.
API_PROXY_TARGET=http://cmep-api:8000
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=admin@cmep.dev
# Used in password-reset links; must be the public HTTPS origin in production.
FRONTEND_URL=http://127.0.0.1:3001
# Public site origin for sitemap.xml / robots.txt / JSON-LD canonical URLs
# (apps/web/src/lib/site.ts). MUST be the public HTTPS origin in production,
# otherwise those URLs fall back to http://localhost:3001.
NEXT_PUBLIC_SITE_URL=https://trc-cmep.sk
# Cloudflare Turnstile site key (client side, public). See TURNSTILE_* below.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

IMAGE_TAG=dev

# =============================================================================
# Cloudflare Turnstile (captcha on register/login). Secret is server-side.
# =============================================================================
# TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# =============================================================================
# Uploads (signed URLs for private documents)
# =============================================================================
# UPLOADS_SIGNING_SECRET falls back to JWT_SECRET_KEY when empty.
UPLOADS_SIGNING_SECRET=
# UPLOADS_REQUIRE_SIGNED=false

# =============================================================================
# Telegram admin notifications (backup uploads / admin alerts)
# =============================================================================
# TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# =============================================================================
# Google OAuth — DECLARED BUT NOT WIRED.
# The Settings fields exist (app/core/config.py) but no router reads them yet,
# so social login is not active. Declared here only for completeness.
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/auth/callback/google

# =============================================================================
# Lead outreach / enrichment (all optional, empty = disabled / no key)
# =============================================================================
# Master switch for sending cold outreach. Keep false unless explicitly running
# a campaign. Empty value is NOT accepted by the typed parser — use true/false.
# LEAD_OUTREACH_ENABLED=false
# LEAD_OUTREACH_DAILY_LIMIT=30

# Resend (primary transactional + outreach provider). Leave empty to disable.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=CMEP
RESEND_REPLY_TO=trc-cmep@gmail.com

# SMTP fallback for transactional auth e-mails (verify / reset / daily matches).
# app/shared/infrastructure/email/sender.py reads SMTP_* via Settings; EMAIL_FROM
# is the From address. If HOST/USERNAME/PASSWORD are empty, auth e-mails are
# logged as a warning and NOT sent (best-effort). Configure BOTH the RESEND_*
# block above and this SMTP block, or auth e-mails will be silently dropped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=

# AI gateway (Groq) — required for AI chat and email drafting. Not a Settings
# field, read via os.getenv; empty disables the feature gracefully.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# AI gateway fallbacks (Mistral, Cerebras) — os.getenv, empty disables gracefully.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_API_URL=https://api.cerebras.ai/v1

# Voice — STT (Groq Whisper) + live token (Deepgram).
GROQ_STT_MODEL=whisper-large-v3-turbo
DEEPGRAM_API_KEY=

# Website discovery (lead_finder). DuckDuckGo needs no key; the Brave key is
# kept only for future fallback and is currently unused.
BRAVE_SEARCH_API_KEY=
# Google Custom Search — legacy/unused, kept for reference.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# =============================================================================
# Background jobs / scheduler (typed — use explicit true/false, not empty)
# =============================================================================
# MATCHING_ENABLED=false
# MATCHING_HOUR=3
# MATCHING_MINUTE=0
# MATCHING_MIN_SCORE=60
# MATCHING_MAX_PER_COMPANY=5
# MATCHING_LOOKBACK_DAYS=7

# Cleanup job for stale pending-verification users (typed — true/false).
CLEANUP_PENDING_USERS_ENABLED=true
CLEANUP_PENDING_USERS_DAYS=7

# =============================================================================
# Metrics / observability
# =============================================================================
# ENABLE_METRICS=false
# METRICS_ALLOWED_IPS=127.0.0.1,::1,localhost

# =============================================================================
# Prediction (experimental, disabled by default)
# =============================================================================
# PREDICTION_SERVICE_ENABLED=false
PREDICTION_ENTITLEMENT_GRANTED=false

# Meta (Facebook) Pixel — client-side analytics
NEXT_PUBLIC_META_PIXEL_ID=

# GoPay payment gateway — DEPRECATED / NOT IMPLEMENTED.
# These names are NOT fields on Settings (app/core/config.py), so they are
# ignored at runtime; the /billing/gopay endpoints always return 503. Kept only
# for historical reference. Do not rely on them.
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_GOID=
GOPAY_API_URL=https://gw.sandbox.gopay.com
GOPAY_RETURN_URL=
GOPAY_NOTIFY_URL=
GOPAY_PRO_AMOUNT_CENTS=0

# Stripe (checkout + webhook) — Settings fields, required for promote-listing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_AMOUNT_CENTS=0
