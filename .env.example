# =============================================================================
# CMEP Platform — Environment Template (.env.example)
# =============================================================================
# Kopiruj: cp .env.example .env && vypln hodnoty
# NIKDY necommituj .env subor!
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=CMEP Platform
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cmep
POSTGRES_USER=cmep_user
POSTGRES_PASSWORD=<GENERUJ SILNE HESLO>
DATABASE_URL=postgresql+asyncpg://{POSTGRES_USER}:{POSTGRES_PASSWORD}@{POSTGRES_HOST}:{POSTGRES_PORT}/{POSTGRES_DB}

# --- Cache / Queue (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://{REDIS_HOST}:{REDIS_PORT}/0

# --- Celery ---
CELERY_BROKER_URL=redis://{REDIS_HOST}:{REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://{REDIS_HOST}:{REDIS_PORT}/2

# --- Security (JWT) ---
# Vygeneruj: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<64+ CHAR SECRET>
JWT_REFRESH_SECRET_KEY=<ODLISNY 64+ CHAR SECRET>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS / Hosts ---
# Pre development:
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# --- Object Storage (MinIO / S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<SILNE HESLO MIN 16 ZNAKOV>
MINIO_ENDPOINT=http://localhost:9000
MINIO_SECURE=false
S3_BUCKET_NAME=cmep-documents
S3_ENDPOINT_URL={MINIO_ENDPOINT}

# --- Email (SMTP) ---
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=<APP_PASSWORD>
EMAIL_FROM=noreply@cmep.local
EMAIL_TLS=true

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# --- Monitoring ---
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
GRAFANA_USER=admin
GRAFANA_PASSWORD=<ZMIEN GRAFANA HESLO>

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- GDPR ---
GDPR_ENABLED=true
GDPR_COOKIE_CONSENT=true
