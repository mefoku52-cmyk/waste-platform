# =============================================================================
# CMEP / Waste Platform — Global .gitignore
# Konsolidované 2026-10-10 (dedup *.bak, odstránené stale one-off pravidlá).
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
dist/
build/
.eggs/
*.egg
*.egg-info/
*.manifest
*.spec
*.whl

# --- Testing / coverage / linting / type-check ---
.tox/
.nox/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/
.cover/
.mypy_cache/
.dmypy.json
dmypy.json
*.pyre/
.ruff_cache/
.ty/

# --- IDEs / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Node.js / Next.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.vercel
*.tsbuildinfo
apps/web/tsconfig.tsbuildinfo

# --- Environment & secrets (nikdy necommitovať) ---
.env
.env.*
!.env.example
secrets/
.secrets/
*.secret
*_secret*.json
secret*.env
secrets*.env
.token
*_token
token*.txt
*.key
*.pem
*.crt
*.p12
*.pfx
*.keystore
.ssh/
.gnupg/

# --- Docker ---
docker-compose.override.yml
docker-compose.local.yml
*.pid
*.pid.lock

# --- Databases (PostgreSQL / SQLite) ---
*.pgdata
*.dump
*.sql.gz
*.backup.sql
*.sqlite
*.sqlite3
*.db
dev.db
waste.db

# --- Redis ---
*.rdb
*.aof
dump.rdb

# --- Logs & runtime data ---
logs/
*.log
*.log.*
!logs/.gitkeep
var/
!var/.gitkeep
data/
!data/.gitkeep

# --- Backups / local edits (jedno miesto pre všetky *.bak varianty) ---
*.bak
*.bak.*
*.bak-*
*.backup
*.backup-*
*.before
*.before-*
*.before_*
*.old
*.legacy
*.unused_duplicate
*.pre-remediation
*.env.bak
.backup/
.fix-backup-*/
.schema-authority-backup-*/
.manual-restore-backups/
.repair-backup-*/
app/main.py.bak*

# --- Generated / audit artefacts ---
*.err
*.zip
output/
reports/
reports/repo-hygiene/
audit_report.json
audit_report.txt
fix_report.txt
PRODUCTION_PROOF*.txt
production_answers.txt

# --- Local operational archives (Termux helpers) ---
__triage_archive/
_local_archive/
_quarantine/
audit-output/
quarantine/

# --- Termux / mobile ---
backend_test_env/
termux/
.atuin/

# --- Poznámka: *.sql je zámerne vypnuté nižšie? NIE. ---
# Schema .sql skripty v koreni (render_missing_tables.sql atď.) sa riešia
# v samostatnom bloku (schema drift). Kým sa nerozhodne, `*.sql` ostáva
# ignorované, aby sa náhodne necommitol ad-hoc schema skript.
*.sql
!migrations/**/*.sql
