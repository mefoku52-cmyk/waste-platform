# Copy to .env.production on the VPS – NEVER commit real values

POSTGRES_USER=cmep
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=cmep

JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM
JWT_REFRESH_SECRET_KEY=CHANGE_ME_LONG_RANDOM_2

# Public site URL (no trailing slash)
FRONTEND_URL=https://example.com
CORS_ALLOWED_ORIGINS=["https://example.com"]
# Browser calls same origin via nginx /api → use relative or full https API
NEXT_PUBLIC_API_BASE_URL=https://example.com

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TLS=true

PLATFORM_ADMIN_EMAILS=admin@example.com
